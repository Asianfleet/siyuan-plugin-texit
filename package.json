{
  "name": "siyuan-plugin-texit",
  "version": "0.1.0",
  "type": "module",
  "description": "Adds a WYSIWYG formula editor to the Siyuan LaTeX formula input panel. Simple and easy to use, naturally integrated into the Siyuan appearance.",
  "repository": "https://github.com/Asianfleet/siyuan-plugin-texit",
  "homepage": "https://github.com/Asianfleet/siyuan-plugin-texit",
  "author": "Asianfleet",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline vite build --watch",
    "build": "cross-env NODE_ENV=production vite build",
    "test": "vitest run",
    "make-link": "node --no-warnings ./scripts/make_dev_link.js",
    "make-link-win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/elevate.ps1 -scriptPath ./scripts/make_dev_link.js",
    "make-install": "pnpm run build && node --no-warnings ./scripts/make_install.js",
    "update-version": "node --no-warnings ./scripts/update_version.js"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "@types/node": "^20.19.11",
    "@types/sync-fetch": "^0.4.3",
    "cross-env": "^7.0.3",
    "fast-glob": "^3.3.3",
    "glob": "^10.4.5",
    "jsdom": "^26.1.0",
    "js-yaml": "^4.1.0",
    "rollup-plugin-livereload": "^2.0.5",
    "sass": "^1.91.0",
    "siyuan": "1.1.5",
    "terser": "^5.44.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite": "^5.4.19",
    "vite-plugin-static-copy": "^1.0.6",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^4.6.2",
    "@vue/tsconfig": "^0.4.0",
    "pinia": "^3.0.3",
    "sync-fetch": "0.6.0-2",
    "vue": "^3.5.20",
    "vue-tsc": "^3.2.6"
  }
}
